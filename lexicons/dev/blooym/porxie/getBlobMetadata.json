{
  "lexicon": 1,
  "id": "dev.blooym.porxie.getBlobMetadata",
  "defs": {
    "main": {
      "type": "query",
      "description": "NOT FINALISED: Fetch and calculate a blob's metadata from the origin via the service. May implement caching depending on implementation.",
      "parameters": {
        "type": "params",
        "required": [
          "did",
          "cid"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "cid": {
            "type": "string",
            "format": "cid"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "integer"
            },
            "contentType": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "MalformedCid",
          "description": "The provided CID was malformed or does not conform to specification."
        },
        {
          "name": "BlobCidMismatch"
        },
        {
          "name": "BlobFetchFailed"
        },
        {
          "name": "BlobForbiddenType"
        },
        {
          "name": "BlobNotFound"
        },
        {
          "name": "BlobTooLarge"
        },
        {
          "name": "CannotResolve"
        },
        {
          "name": "CidUnsupported"
        },
        {
          "name": "PolicyForbidden"
        }
      ]
    }
  }
}