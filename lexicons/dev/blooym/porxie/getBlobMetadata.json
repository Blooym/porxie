{
  "lexicon": 1,
  "id": "dev.blooym.porxie.getBlobMetadata",
  "defs": {
    "main": {
      "type": "query",
      "description": "Fetch and calculate a blob's metadata from the origin via the service. May implement caching depending on implementation.",
      "parameters": {
        "type": "params",
        "required": [
          "did",
          "cid"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "cid": {
            "type": "string",
            "format": "cid"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "integer"
            },
            "contentType": {
              "type": "string"
            },
            "data": {
              "type": "union",
              "closed": false,
              "refs": [
                "#imageData",
                "#videoData"
              ]
            }
          }
        }
      },
      "errors": [
        {
          "name": "MalformedCid",
          "description": "The provided CID was malformed or does not conform to specification."
        },
        {
          "name": "BlobCidMismatch"
        },
        {
          "name": "BlobFetchFailed"
        },
        {
          "name": "BlobForbiddenType"
        },
        {
          "name": "BlobNotFound"
        },
        {
          "name": "BlobTooLarge"
        },
        {
          "name": "CannotResolve"
        },
        {
          "name": "CidUnsupported"
        },
        {
          "name": "PolicyForbidden"
        }
      ]
    },
    "imageData": {
      "type": "object",
      "required": [
        "aspectRatio"
      ],
      "properties": {
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        }
      }
    },
    "videoData": {
      "type": "object",
      "required": [
        "aspectRatio",
        "durationMs"
      ],
      "properties": {
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "aspectRatio": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}